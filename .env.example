# RailBlock AI — Environment template (copy to .env, never commit .env)
# Local dev (SQLite fallback, no external DB needed)
# DATABASE_URL=sqlite:///./backend/railblock.db
# DATABASE_MODE=sqlite

# Supabase Postgres — single source of truth for hosted single-instance
# Use pooled 6543 for Render (pgbouncer), direct 5432 for local manual upload
# Render Dashboard → railblock-ai → Environment → add as sync:false (secret)
# Local: export $(grep DATABASE .env | xargs) && python scripts/reset_demo.py

# Pooled (Render production — recommended, 6543 is PgBouncer pooler via Supavisor; psycopg2 needs no pgbouncer param — 6543 host:port is the pooler)
# Use Transaction Pooler host aws-0-*.pooler.supabase.com:6543 with user postgres.<project_ref>
# Note: 6543 is PgBouncer via Supavisor — psycopg2-binary needs no `pgbouncer=true` param; host:port 6543 alone activates pooling.
DATABASE_URL=postgresql://postgres.qgkxdvtrqjhcgnwggzxh:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_MODE=postgres

# Direct (local one-off manual synthetic upload via psql / reset_demo.py)
# DATABASE_URL=postgresql://postgres:<NEW_PASSWORD>@db.qgkxdvtrqjhcgnwggzxh.supabase.co:5432/postgres?sslmode=require
# DATABASE_MODE=postgres

# Optional: transaction pooler docs https://supabase.com/docs/guides/database/connecting-to-postgres
# After rotating password edUNW0TT5hnzt9s6 in Supabase → update both .env and Render env
