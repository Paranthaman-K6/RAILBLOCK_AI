# Vercel split deployment — frontend on Vercel Hobby, backend on Render
# Set this as Vercel dashboard env var (Production/Preview):
#   VITE_API_URL=https://railblock-ai-up0g.onrender.com
# Do NOT set VITE_API_URL="" on Vercel; "" is same-origin single-image (Render) only.
# Local .env.production stays VITE_API_URL="" for Render single-image (Docker) build.
VITE_API_URL=https://railblock-ai-up0g.onrender.com
