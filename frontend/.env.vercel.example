# Vercel split deployment — frontend on Vercel, backend on Render (API-only)
# Canonical source: Vercel Dashboard → Settings → Environment Variables
#   VITE_API_URL=https://railblock-ai-up0g.onrender.com  (Production/Preview/Development)
# .env.production stays VITE_API_URL="" for local/docker fallback; api.ts prod guard falls back to Render.
# Do NOT commit a .env.production.vercel file — use dashboard var only.
VITE_API_URL=https://railblock-ai-up0g.onrender.com
